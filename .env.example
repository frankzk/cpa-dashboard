# ─── Frontend (Vite — prefix VITE_ so the browser can read them) ─────────────

# Google OAuth 2.0 Client ID
# 1. console.cloud.google.com → APIs & Services → Credentials
# 2. + Create Credential → OAuth 2.0 Client ID → Web application
# 3. Authorized JS origins: http://localhost:5173  +  https://your-app.vercel.app
# 4. No redirect URIs needed (implicit/token flow)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com


# ─── Server-side only (Vercel Functions — NOT prefixed with VITE_) ────────────
# Set these in the Vercel dashboard: Project → Settings → Environment Variables

# Supabase project URL  (supabase.com → your project → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase service role key  ⚠ NEVER expose this to the browser
# (supabase.com → your project → Settings → API → service_role secret)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ─── Google Cloud setup checklist ────────────────────────────────────────────
# Enable these APIs in console.cloud.google.com → APIs & Services → Library:
#   ✓ Google Sheets API   (for reading spreadsheet data)
#   ✓ Google Identity     (included by default with OAuth)
#
# The Sheets API Key (used in-app for reading sheets) is entered directly
# in the UI — it is NOT stored here.
